{
  "name": "discord-codex-bridge",
  "version": "1.1.0",
  "description": "A private Discord bot for Codex conversations through your own ChatGPT login.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/start.js",
    "test": "node --test test/*.test.js",
    "check": "node --env-file-if-exists=.env src/check.js",
    "lint": "node scripts/check-syntax.js",
    "security": "node scripts/check-release.js",
    "release": "node scripts/release.js",
    "smoke": "node scripts/smoke.js"
  },
  "dependencies": {
    "discord.js": "14.27.0"
  }
}
