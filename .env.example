# Copy this file to .env and run: chmod 600 .env
# Keep .env on your server. Never commit it or paste it into an issue.

# Discord Developer Portal > your application > Bot > Token.
DISCORD_BOT_TOKEN=""

# Enable Developer Mode in Discord, then right-click to copy each ID.
# All three lists are required. Separate multiple IDs with commas.
# Choose trusted users and private channels. Everyone who can read a channel
# can read the bot's replies. An allowed channel also permits its threads.
DISCORD_ALLOWED_USER_IDS=""
DISCORD_ALLOWED_GUILD_IDS=""
DISCORD_ALLOWED_CHANNEL_IDS=""

# Optional settings. Relative paths start from the project directory.
# BRIDGE_DATA_DIR=./data
# CODEX_BIN=codex
# CODEX_MODEL=
# CODEX_TIMEOUT_SECONDS=600

# disabled keeps web search off. Set live for current research, or cached for
# indexed results. Search queries may contain details from your prompts/context.
# CODEX_WEB_SEARCH=disabled
